# Reown project ID (wallet connection). Create one at https://dashboard.reown.com
VITE_REOWN_PROJECT_ID=

# Optional: a dedicated Solana mainnet RPC (for example Helius or QuickNode).
# Leave empty to use Reown's Solana RPC (keyed by the project ID above), with PublicNode as fallback.
VITE_SOLANA_RPC_URL=
