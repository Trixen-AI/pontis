# Reown project ID (wallet connection). Create one at https://dashboard.reown.com
VITE_REOWN_PROJECT_ID=

# Optional: a dedicated Robinhood Chain RPC (for example Alchemy).
# Leave empty to use the public, rate-limited RPC.
VITE_ROBINHOOD_RPC_URL=

# Ponsia Perps engine contract address on Robinhood Chain.
# Leave empty until the engine is deployed: markets, charts and wallet data stay live,
# and opening or closing positions stays disabled.
VITE_PONSIA_PERPS_ADDRESS=
